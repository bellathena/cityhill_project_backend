# ============================================================
# CityHill Backend - Environment Variables
# ============================================================
# Copy this file to .env and update the values for your environment.
# Never commit .env to version control.

# Node environment
NODE_ENV=development

# Server port
PORT=5000

# JWT secret for signing tokens (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database URL (MySQL via Prisma)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# For local MySQL:
DATABASE_URL=mysql://root:password@localhost:3306/cityhill

# For Docker Compose (MySQL runs in a container named "db"):
# DATABASE_URL=mysql://cityhill:cityhill123@db:3306/cityhill?allowPublicKeyRetrieval=true

# Docker Compose MySQL credentials (only used by docker-compose.yml)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=cityhill
MYSQL_USER=cityhill
MYSQL_PASSWORD=cityhill123
